{% extends 'public/base.html.twig' %}
{% import 'public/_macros.html.twig' as m %}

{% block title %}{{ 'app.site_name'|trans }}{% endblock %}

{% block public_body %}
    {% if featuredArticle %}
        <article class="hero-feature">
            <a class="hero-feature__media" href="{{ path('app_article_show', {id: featuredArticle.id, slug: featuredArticle.title|slugify}) }}" aria-hidden="true" tabindex="-1">
                {% if featuredArticle.image %}<img src="{{ featuredArticle.image }}" alt="">{% endif %}
                <span class="badge badge-sponsored hero-feature__badge">{{ 'article_list.sponsored'|trans }}</span>
            </a>
            <div class="hero-feature__body">
                <div class="article-card__meta">{{ m.article_meta(featuredArticle) }}</div>
                <h2 class="hero-feature__title"><a href="{{ path('app_article_show', {id: featuredArticle.id, slug: featuredArticle.title|slugify}) }}">{{ featuredArticle.title }}</a></h2>
                {% if featuredArticle.description %}
                    <p class="hero-feature__excerpt">{{ featuredArticle.description }}</p>
                {% endif %}
                {{ m.keyword_tags(featuredArticle.keywords) }}
            </div>
        </article>
    {% endif %}

    {% if latestSyntheses|default([])|length > 0 %}
        <section class="section">
            <div class="section-head">
                <span class="section-title">{{ 'home.last_week_syntheses'|trans }}</span>
                <a class="see-all" href="{{ path('app_synthesis_index') }}">{{ 'home.see_all_syntheses'|trans }} →</a>
            </div>
            <div class="carousel" data-carousel>
                <button type="button" class="carousel__nav carousel__nav--prev" data-carousel-prev aria-label="{{ 'pagination.previous'|trans }}">‹</button>
                <div class="carousel__track" data-carousel-track>
                    {% for synthesis in latestSyntheses %}
                        <div class="carousel__item">{{ m.synthesis_card(synthesis) }}</div>
                    {% endfor %}
                </div>
                <button type="button" class="carousel__nav carousel__nav--next" data-carousel-next aria-label="{{ 'pagination.next'|trans }}">›</button>
            </div>
        </section>
    {% endif %}

    <section class="section">
        <div class="section-head">
            <span class="section-title">{{ 'home.latest_articles'|trans }}</span>
        </div>
        {% include 'public/_article_list.html.twig' %}
    </section>

    {% include 'public/_newsletter.html.twig' %}
{% endblock %}
