{% extends 'public/base.html.twig' %}
{% import 'public/_macros.html.twig' as m %}

{% block title %}{{ article.title }} — {{ 'app.site_name'|trans }}{% endblock %}

{% block mobile_title %}{{ article.feed and article.feed.label ? article.feed.label : 'article_show.breadcrumb_current'|trans }}{% endblock %}
{% block mobile_context_action %}
    <a class="header-icon-btn" data-share href="{{ article.url }}" rel="nofollow noopener" target="_blank"
       data-share-url="{{ article.url }}" data-share-title="{{ article.title }}" aria-label="{{ 'article_show.share'|trans }}">⤴</a>
{% endblock %}

{% block public_body %}
    <div class="with-sidebar">
        <article class="article-detail">
            <div class="breadcrumb">
                <a href="{{ path('app_home') }}">{{ 'nav.home'|trans }}</a>
                {% if article.feed and article.feed.label %} · {{ article.feed.label }}{% endif %}
                · <span class="current">{{ 'article_show.breadcrumb_current'|trans }}</span>
            </div>

            <div>
                {% if article.feed and article.feed.sponsored %}
                    <p><span class="badge badge-sponsored">{{ 'article_list.sponsored'|trans }}</span></p>
                {% endif %}
                <h1 class="article-detail__title">{{ article.title }}</h1>
            </div>

            <div class="article-detail__meta">
                {% if article.feed and article.feed.label %}<span class="source">{{ article.feed.label }}</span><span>·</span>{% endif %}
                <span>{{ article.publicationDate|date('d/m/Y H:i') }}</span>
                {% if article.language.value != app.request.locale %}<span class="lang-flag">{{ article.language.value|upper }}</span>{% endif %}
            </div>

            {% if article.image %}
                <div class="article-detail__media"><img src="{{ article.image }}" alt=""></div>
            {% endif %}

            {% if article.description %}
                <div class="prose"><p class="lead">{{ article.description }}</p></div>
            {% endif %}

            <div class="share-row">
                <div>{{ 'article_show.read_original_on'|trans }} <a href="{{ article.url }}" rel="nofollow noopener" target="_blank">{{ article.url|split('/')[2]|default(article.url) }} ↗</a></div>
                <div class="share-row__actions">
                    <a class="btn btn-secondary btn-sm" href="{{ article.url }}" rel="nofollow noopener" target="_blank">{{ 'article_show.share'|trans }}</a>
                </div>
            </div>

            {% if article.keywords|length > 0 %}
                <div class="section" style="gap:10px">
                    <span class="eyebrow">{{ 'article_show.article_keywords'|trans }}</span>
                    {{ m.keyword_tags(article.keywords) }}
                </div>
            {% endif %}

            {% if similarArticles|length > 0 %}
                <section class="section" style="margin-top:8px">
                    <div class="section-head">
                        <span class="section-title">{{ 'article_show.similar'|trans }}</span>
                    </div>
                    <div class="card-grid cols-3">
                        {% for similar in similarArticles %}
                            {{ m.article_card(similar) }}
                        {% endfor %}
                    </div>
                </section>
            {% endif %}
        </article>

        <aside class="sidebar">
            {% if article.countries|length > 0 %}
                {% for country in article.countries %}
                    <div class="card card--pad" style="display:flex; flex-direction:column; gap:12px">
                        <div class="country-widget">
                            <span class="flag">{{ country.code|country_flag }}</span>
                            <div>
                                <div class="country-widget__name">{{ app.request.locale == 'en' ? country.nameEn : country.nameFr }}</div>
                            </div>
                        </div>
                        <a class="btn btn-block" href="{{ path('app_country_show', {code: country.code}) }}">{{ 'article_show.see_country'|trans }} →</a>
                    </div>
                {% endfor %}
            {% endif %}

            {% include 'public/_newsletter.html.twig' with {variant: 'compact'} %}
        </aside>
    </div>

    {# Barre d'actions collante — mobile uniquement (design C). #}
    <div class="mobile-action-bar">
        <a class="btn btn-secondary" data-share href="{{ article.url }}" rel="nofollow noopener" target="_blank"
           data-share-url="{{ article.url }}" data-share-title="{{ article.title }}">{{ 'article_show.share'|trans }}</a>
        <a class="btn" href="{{ article.url }}" rel="nofollow noopener" target="_blank">{{ 'article_show.read_original'|trans }} ↗</a>
    </div>
{% endblock %}
