{% extends 'public/base.html.twig' %}

{% block title %}{{ feed.label ?? feed.url }} — {{ 'app.site_name'|trans }}{% endblock %}

{% block mobile_title %}{{ feed.label ?? feed.url }}{% endblock %}

{% block public_body %}
    <div class="page-hero">
        <div>
            <div class="page-hero__eyebrow">{{ 'article_list_by_feed.eyebrow'|trans }}</div>
            <h1 class="page-hero__title">{{ feed.label ?? feed.url }}</h1>
            <div class="page-hero__meta">{{ 'article_list.count'|trans({'%count%': pagination.totalItems}) }}</div>
        </div>
    </div>

    <div class="with-sidebar">
        <div class="stack">
            {% include 'public/_article_list.html.twig' %}
        </div>
        <aside class="sidebar">
            {% include 'public/_newsletter.html.twig' with {variant: 'compact'} %}
        </aside>
    </div>
{% endblock %}
